</span></span><span class="line"><span class="cl">			<span class="k">return</span> <span class="k">new</span> <span class="nx">SmoothScrollingUpdate</span><span class="p">(</span><span class="nx">newScrollLeft</span><span class="p">,</span> <span class="nx">newScrollTop</span><span class="p">,</span> <span class="kc">false</span><span class="p">);</span>
